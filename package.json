{
  "name": "deadlock-draft-oracle",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Hero randomizer for Deadlock — solo picks or a full squad of six, from the live community roster feeds.",
  "keywords": [
    "deadlock",
    "randomizer",
    "hero-picker"
  ],
  "homepage": "https://sergeydus.github.io/deadlock-draft-oracle/",
  "license": "MIT",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "test": "node scripts/test.mjs",
    "test:offline": "node scripts/test.mjs --offline",
    "typecheck": "tsc --noEmit",
    "preview:subpath": "vite preview --base /deadlock-draft-oracle/ --port 5174"
  },
  "dependencies": {
    "mobx": "^6.13.0",
    "mobx-react-lite": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
