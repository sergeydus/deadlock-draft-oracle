{
  "name": "deadlock-draft-oracle",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Hero randomizer for Deadlock — solo picks or a full squad of six, from the live community roster feeds.",
  "keywords": ["deadlock", "randomizer", "hero-picker"],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "test": "node scripts/verify.mjs",
    "test:offline": "node scripts/verify.mjs --offline",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mobx": "^6.13.0",
    "mobx-react-lite": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
